{
  "name": "yt-dlandcut",
  "version": "4.0.0",
  "private": true,
  "description": "Download and cut YouTube videos or export clips as MP3",
  "repository": "github:markkop/yt-dlandcut",
  "main": "src/electron/main.js",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "start": "electron .",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.js",
    "check": "npm run lint && npm run format:check && npm test",
    "tools:update": "node scripts/update-tools.js",
    "pack": "electron-builder --dir --publish never",
    "build": "electron-builder --publish never",
    "release": "electron-builder --publish always",
    "test:media": "node scripts/smoke-media.js"
  },
  "keywords": [
    "yt-dlp",
    "ffmpeg",
    "electron",
    "youtube",
    "video"
  ],
  "author": "Marcelo 'Mark' Kopmann <marcelokopmann@gmail.com> (https://markkop.dev)",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "jsdom": "30.1.3"
  },
  "build": {
    "appId": "com.electron.yt-dlandcut",
    "productName": "YouTube - Download and Cut",
    "asar": true,
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json",
      "tools-manifest.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "public/256x256.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/256x256.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "public/256x256.icns",
      "hardenedRuntime": true
    },
    "appImage": {
      "executableArgs": []
    },
    "publish": {
      "provider": "github",
      "owner": "Markkop",
      "repo": "yt-dlandcut",
      "releaseType": "draft"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    }
  },
  "desktopName": "com.electron.yt-dlandcut.desktop"
}
